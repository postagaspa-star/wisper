# Copia questo file in .env (accanto a docker-compose.yml) e mettici i valori veri.
# Il .env NON va su GitHub: qui sotto ci sono solo valori finti.

# Lo stesso valore della proprieta' SEGRETO_SERVER dello script del foglio (Apps Script):
# serve al ponte (lo script chiama il server) e al postino (il server chiama lo script).
SEGRETO_SERVER=metti-qui-un-segreto-lungo-e-casuale

# L'indirizzo dello script pubblicato (Esegui il deployment > App web), quello che finisce con /exec.
WISPER_POSTINO_URL=https://script.google.com/macros/s/ID-FINTO-DELLO-SCRIPT/exec

# Il segreto che il server manda al postino. Di solito lo stesso di SEGRETO_SERVER.
WISPER_POSTINO_SEGRETO=metti-qui-un-segreto-lungo-e-casuale

# A che ora si fa la copia di sicurezza ogni notte (ora italiana).
WISPER_ORA_COPIA=02:30

# La chiave di Tailscale per il contenitore wisper-tailscale (admin console > Settings > Keys).
TS_AUTHKEY=tskey-auth-finta-0000000000
