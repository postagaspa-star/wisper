# Copia questo file in .env (accanto a docker-compose.yml) e mettici i valori veri.
# Il .env NON va su GitHub: qui sotto ci sono solo valori finti.

# Lo stesso valore della proprieta' SEGRETO_SERVER dello script del foglio (Apps Script):
# serve al ponte (lo script chiama il server) e al postino (il server chiama lo script).
SEGRETO_SERVER=metti-qui-un-segreto-lungo-e-casuale

# L'indirizzo dello script pubblicato (Esegui il deployment > App web), quello che finisce con /exec.
WISPER_POSTINO_URL=https://script.google.com/macros/s/ID-FINTO-DELLO-SCRIPT/exec

# Il segreto che il server manda al postino. Di solito lo stesso di SEGRETO_SERVER.
WISPER_POSTINO_SEGRETO=metti-qui-un-segreto-lungo-e-casuale

# L'invito (02/11/2026): lo stesso testo scritto in INVITO_NAS nel file dello script che si incolla. Con quello lo
# script impara da solo il segreto alla prima chiamata del server: nessuna proprieta' da scrivere a mano.
WISPER_INVITO_SCRIPT=

# La porta Google (docs/gestionale/porta-google.md): con WISPER_POSTINO_URL e il segreto qui sopra il server va a
# prendere da solo, dallo script del foglio, le richieste di telefoni e computer fuori casa. Niente da aprire a casa.
# Quanti secondi lo script tiene aperta ogni chiamata del server (di base 45, al massimo 55).
WISPER_PORTA_ATTESA=45
# Secondi di pausa fra una chiamata senza lavoro e l'altra (di base 0). Strada di riserva, se Google un giorno non
# volesse chiamate tenute aperte: WISPER_PORTA_ATTESA=0 e WISPER_PORTA_PAUSA=3.
WISPER_PORTA_PAUSA=0
# "no" la spegne (di base accesa quando ci sono indirizzo e segreto).
WISPER_PORTA_GOOGLE=si

# A che ora si fa la copia di sicurezza ogni notte (ora italiana).
WISPER_ORA_COPIA=02:30

# La chiave di Tailscale per il contenitore wisper-tailscale (admin console > Settings > Keys).
TS_AUTHKEY=tskey-auth-finta-0000000000

# L'ingresso da internet (contenitore wisper-ingresso, README "Internet entrance"): l'indirizzo IPv4
# pubblico e fisso di casa, quello per cui Caddy chiede il certificato a Let's Encrypt. Qui un indirizzo
# finto di esempio (203.0.113.x e' riservato alla documentazione): quello vero solo nel .env del NAS.
WISPER_IP_PUBBLICO=203.0.113.10

# "si" solo nelle settimane del cambio, quando lo script del foglio deve raggiungere /ponte da internet;
# il resto del tempo "no" (/ponte risponde 404 da fuori, da casa funziona sempre).
WISPER_PONTE_DA_FUORI=no

# Fase 7, il portale clienti (docs/gestionale/fase7.md §0): l'indirizzo dello script DEL PORTALE (un progetto Apps
# Script a parte, quello che finisce con /exec) e il suo segreto, NUOVO e diverso da SEGRETO_SERVER (nello script del
# portale e' la proprieta' SEGRETO_SERVER). Vuoti: il portale resta "Non collegato".
WISPER_PORTALE_URL=
SEGRETO_PORTALE=
# L'invito dello script del portale (come WISPER_INVITO_SCRIPT).
WISPER_INVITO_PORTALE=

# Fase 8 (docs/gestionale/fase8.md §4, §5, §9). Tutte facoltative: vuote, il server usa i valori di base.
# L'indirizzo con cui telefoni e computer di casa raggiungono il server, per i feed del calendario "in casa"
# (http://<nome o IP del NAS>:8400). Vuoto: lo prende dalla richiesta di chi crea il feed.
WISPER_INDIRIZZO_CASA=
# Il servizio europeo delle partite IVA (VIES). Vuoto = quello vero della Commissione europea; nelle prove un finto.
WISPER_VIES_URL=
# Dove guardare se c'e' una versione nuova (l'ultima release su GitHub). Vuoto = il repository di Wisper.
WISPER_AGGIORNAMENTI_URL=
# Solo per le prove (funziona solo con --prova): "si" fa finta che SQLite non abbia FTS5, per provare la ricerca
# dentro i file che si spegne da sola. Sul NAS non serve mai.
# WISPER_SENZA_FTS5=si
