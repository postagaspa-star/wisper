<Project>
  <!--
    bin/ e obj/ fuori da OneDrive: il Desktop è sincronizzato, e OneDrive che
    blocca un file mentre lo carica fa fallire la build a caso ("file in uso").
    Il pacchetto finale resta in pc/dist (prove/crea-pacchetto.ps1).
  -->
  <PropertyGroup>
    <WisperCartellaBuild>$(LOCALAPPDATA)\WisperUfficio-build\</WisperCartellaBuild>
    <BaseIntermediateOutputPath>$(WisperCartellaBuild)$(MSBuildProjectName)\obj\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(WisperCartellaBuild)$(MSBuildProjectName)\bin\</BaseOutputPath>
  </PropertyGroup>
</Project>
