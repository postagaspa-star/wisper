<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Il foglio Google. Niente microfono e niente posizione: il rapportino si
         compila a mano, e il luogo, se serve, lo scrive chi lo compila. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Per mandare i rapportini rimasti sul telefono appena torna il segnale. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- L'avviso "rapportino non ancora sul foglio" quando l'app e' chiusa. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".WisperApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Wisper">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Wisper">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- La fotocamera scrive la foto dello scontrino direttamente in un
             file dell'app: serve un indirizzo che possa raggiungere. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.foto"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/percorsi_foto" />
        </provider>

    </application>
</manifest>
