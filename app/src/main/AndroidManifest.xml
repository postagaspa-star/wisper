<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Il foglio Google. Niente microfono e niente posizione: il rapportino si
         compila a mano, e il luogo, se serve, lo scrive chi lo compila. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Per mandare i rapportini rimasti sul telefono appena torna il segnale. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- L'avviso "rapportino non ancora sul foglio" quando l'app e' chiusa. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Per installare da sola le versioni nuove (NuoveVersioni.kt): solo APK firmati
         con la stessa chiave dell'app, Android non accetta altro. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Da Android 12: le versioni dopo la prima si installano senza chiedere niente,
         perché a installarle è Wisper stesso (e solo se l'app è chiusa). -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- I promemoria delle attività e degli appuntamenti (Promemoria.kt): la sveglia di
         Android all'ora giusta, anche ad app chiusa, e di nuovo dopo un riavvio. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".WisperApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/rete_casa"
        android:supportsRtl="true"
        android:theme="@style/Theme.Wisper">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Wisper">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Fase 4: le fatture elettroniche arrivate per email o WhatsApp (.xml, .p7m, .zip)
                 si condividono con Wisper, che le fa leggere al server (Fatturazione, Importa l'XML).
                 application/octet-stream perché molte app mandano così i .p7m: i file che non
                 finiscono in .xml, .p7m o .zip li scarta l'app con la sua frase. -->
            <intent-filter android:label="Importa in Wisper">
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="text/xml" />
                <data android:mimeType="application/pkcs7-mime" />
                <data android:mimeType="application/x-pkcs7-mime" />
                <data android:mimeType="application/pkcs7-signature" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <!-- Fase 5 (fase5.md §3.1): il collegamento di OneDrive, SharePoint o Drive ("Copia
                 collegamento", Condividi) e i PDF e le foto vanno in Documenti, Aggiungi un documento.
                 Il file resta su OneDrive o Drive: Wisper tiene solo l'indirizzo. -->
            <intent-filter android:label="Metti nei documenti di Wisper">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter android:label="Importa in Wisper">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="text/xml" />
                <data android:mimeType="application/pkcs7-mime" />
                <data android:mimeType="application/x-pkcs7-mime" />
                <data android:mimeType="application/zip" />
            </intent-filter>
        </activity>

        <!-- Le risposte dell'installazione di una versione nuova. -->
        <receiver android:name=".EsitoInstallazione" android:exported="false" />

        <!-- I promemoria: la notifica all'ora scelta, e le sveglie rimesse dopo un riavvio. -->
        <receiver android:name=".AvvisoPromemoria" android:exported="false" />
        <receiver android:name=".RiavvioPromemoria" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- La fotocamera scrive la foto dello scontrino direttamente in un
             file dell'app: serve un indirizzo che possa raggiungere. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.foto"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/percorsi_foto" />
        </provider>

        <!-- I PDF del rapportino e del riepilogo, da aprire o condividere con un'altra
             app (rapportino/Stampa.kt). Provider a parte: non vede le foto, e viceversa. -->
        <provider
            android:name=".rapportino.StampaFile"
            android:authorities="${applicationId}.pdf"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/percorsi_pdf" />
        </provider>

    </application>
</manifest>
