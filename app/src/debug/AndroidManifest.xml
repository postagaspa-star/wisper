<?xml version="1.0" encoding="utf-8"?>
<!-- Solo nelle build di prova: permette di parlare col finto Google e col server di
     prova sul computer (apps-script/prove/finto-google.js, server/src/avvio.js in prova),
     che non hanno https. L'app vera parla in chiaro solo col server dello studio in
     casa (res/xml/rete_casa.xml); Google sempre in https. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:networkSecurityConfig="@xml/rete_prove"
        tools:replace="android:networkSecurityConfig" />
</manifest>
